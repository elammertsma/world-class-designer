# Copy to .env.agents in your project (and add .env.agents to .gitignore),
# or to ~/.claude/.env.agents for every project. The skill's scripts read these
# automatically; environment variables already set take precedence.

# Image generation (Google AI Studio -> Get API key)
GEMINI_API_KEY=

# Video generation and background removal (fal.ai -> Dashboard -> Keys). Optional; video is skipped without it.
FAL_KEY=

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_QUALITY_MODEL=gemini-3-pro-image
# FAL_I2V_MODEL=bytedance/seedance-2.5/image-to-video
# FAL_MATTING_MODEL=veed/video-background-removal
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
